# FlowForge AI configuration. setup.bat copies this to .env and generates the key below.
# Never commit .env.

# development | production
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000

# Leave blank to use a local SQLite file (backend/data/flowforge.db).
# PostgreSQL: postgresql+psycopg://user:password@localhost:5432/flowforge
# DATABASE_URL=

# Fernet key that encrypts stored credentials. Generated by scripts/ensure_env.py.
# Required in production. Losing it makes stored credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Set to true when serving over HTTPS (required when APP_ENV=production).
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=72

# Public demo login with seeded, labelled records. Turn off in production.
DEMO_MODE_ENABLED=true

# Run the job queue and scheduler inside the API process.
# Set false and run `python -m app.worker` to scale them separately.
WORKER_ENABLED=true
WORKER_CONCURRENCY=4

# Limits
MAX_EXECUTION_SECONDS=300
MAX_NODE_EXECUTIONS=2000
MAX_LOOP_ITERATIONS=1000
MAX_DELAY_SECONDS=300
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_RATE_PER_MINUTE=60

# SSRF development exception: comma separated hosts the HTTP node may reach even
# though they are private. Ignored when APP_ENV=production.
ALLOW_PRIVATE_HTTP_HOSTS=

# Optional server-wide AI keys (workspace credentials take priority).
# With none configured, AI features run in clearly labelled demo mode.
AI_DEFAULT_PROVIDER=
AI_TIMEOUT_SECONDS=90
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
